+/// Starling's port: Sunrise's tooltip lines are rich text with a colour. The line's leading `§`
+/// formatting code becomes that colour, as the game drew it from the plain line.
+fn tooltip_line(line: String) -> (mod_api::Text, u32) {
+    let mut chars = line.chars();
+    if chars.next() == Some('§')
+        && let Some(code) = chars.next()
+    {
+        let colour = match code.to_ascii_lowercase() {
+            '0' => Some(0xFF00_0000), '1' => Some(0xFF00_00AA), '2' => Some(0xFF00_AA00), '3' => Some(0xFF00_AAAA),
+            '4' => Some(0xFFAA_0000), '5' => Some(0xFFAA_00AA), '6' => Some(0xFFFF_AA00), '7' => Some(0xFFAA_AAAA),
+            '8' => Some(0xFF55_5555), '9' => Some(0xFF55_55FF), 'a' => Some(0xFF55_FF55), 'b' => Some(0xFF55_FFFF),
+            'c' => Some(0xFFFF_5555), 'd' => Some(0xFFFF_55FF), 'e' => Some(0xFFFF_FF55), 'f' => Some(0xFFFF_FFFF),
+            _ => None,
+        };
+        if let Some(colour) = colour {
+            return (mod_api::Text::literal(chars.as_str().to_owned()), colour);
+        }
+    }
+    (mod_api::Text::literal(line), 0xFFFF_FFFF)
+}
