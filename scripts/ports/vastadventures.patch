+/// One of this mod's loot conditions, registered under its id.
+struct LootCondition(&'static str);
+
+impl mod_api::ModLootCondition for LootCondition {
+    fn validate(&self, _: &mod_api::LootEntryData) -> Result<(), String> {
+        Ok(())
+    }
+
+    fn test(&self, _: &mod_api::LootEntryData, context: &mut dyn mod_api::LootTypeContext) -> Result<bool, String> {
+        let ctx = context.snapshot();
+        let entity = ctx.entity.as_ref().map(|e| e.kind.as_str());
+        loot::loot_condition(self.0, has_player(&ctx), entity).ok_or_else(|| format!("{}: not a condition", self.0))
+    }
+}
+
+/// One of this mod's loot functions, registered under its id.
+struct LootFunction(&'static str);
+
+impl mod_api::ModLootFunction for LootFunction {
+    fn validate(&self, _: &mod_api::LootEntryData) -> Result<(), String> {
+        Ok(())
+    }
+
+    fn apply(
+        &self,
+        data: &mod_api::LootEntryData,
+        mut stack: mod_api::LootStack,
+        context: &mut dyn mod_api::LootTypeContext,
+    ) -> Result<mod_api::LootStack, String> {
+        let ctx = context.snapshot();
+        // The roll's own random gives the seed the context no longer carries.
+        let seed = context.random().next_long();
+        loot_function(self.0, data.value(), &ctx, seed, &mut stack);
+        Ok(stack)
+    }
+}
