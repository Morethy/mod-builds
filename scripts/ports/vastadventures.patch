+        let ctx = context.snapshot();
+        // The roll's own random gives the seed the context no longer carries.
+        let seed = context.random().next_long();
+        loot_function(self.0, data.value(), &ctx, seed, &mut stack);
+        Ok(stack)
+    }
+}
