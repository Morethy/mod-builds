+/// Run the five usages [`command_declarations`] declares, after the game parsed and
+/// permission-checked them.
+fn run_command(host: &mut dyn ServerHost, command: &CommandInvocation) -> Option<i32> {
+  let literals: Vec<&str> = command.literals.iter().map(String::as_str).collect();
+  match literals.as_slice() {
+    ["createaddition", "info"] => command_info(host, command),
+    ["createaddition", "energy"] => command_energy(host, command),
+    ["createaddition", "link"] => command_link(host, command),
+    ["createaddition", "unlink"] => command_unlink(host, command),
+    ["createaddition", "mode"] => command_mode(host, command),
+    _ => return None,
+  }
+  Some(1)
+}
