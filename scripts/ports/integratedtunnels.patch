+/// Run the two usages [`Hooks::register_commands`] declares, after the game has
+/// parsed and permission-checked them.
+fn run_command(
+    host: &mut dyn ServerHost,
+    _source: &mod_api::CommandSource,
+    command: &mod_api::CommandInvocation,
+) -> Option<i32> {
+    let literals: Vec<&str> = command.literals.iter().map(String::as_str).collect();
+    match literals.as_slice() {
+        ["integratedtunnels", "info"] => {
+            cable::info(host, command);
+            Some(1)
+        }
+        ["integratedtunnels", "part"] => {
+            cable::set_part(host, command);
+            Some(1)
         }
+        _ => None,
     }
 }
