@@ -53,9 +53,33 @@ impl BlockEntityPart for RiftPart {
         event.ticks = true;
     }
 
-    fn block_entity_tick(&self, host: &mut dyn ServerHost, event: &mut BlockEntityTickEvent<'_>) {
-        let pos = event.pos;
-        rift::tick(host, self.rift, &self.block, pos, &mut event.entity.nbt);
+    fn block_entity_tick(&self, event: &mut BlockEntityTickEvent<'_>) {
+        let Some((pos, saved)) = event.subject.with_view(|view| (view.position(), view.nbt().clone())) else {
+            return;
+        };
+        let mut nbt = saved.clone();
+        rift::tick(event.subject.host(), self.rift, &self.block, pos, &mut nbt);
+        if nbt == saved {
+            return;
+        }
+        // Write back the fields the tick changed, as the tick's own compound was kept before.
+        let written = event.subject.with_view(|mut view| {
+            let mut changed = false;
+            for key in saved.keys() {
+                if !nbt.contains_key(key) {
+                    changed |= view.set_nbt(key.clone(), None);
+                }
+            }
+            for (key, value) in nbt.iter() {
+                if saved.get(key) != Some(value) {
+                    changed |= view.set_nbt(key.clone(), Some(value.clone()));
+                }
+            }
+            (changed, view.handle())
+        });
+        if let Some((true, handle)) = written {
+            let _ = handle.set_changed(event.subject.host());
+        }
     }
 }
 
