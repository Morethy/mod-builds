+
+#[mod_api::sunrise_part]
+impl MenuPart for Clicks {
+    fn menu_clicked(&self, host: &mut dyn ServerHost, event: &mut MenuClickedEvent<'_>) -> Flow {
+        let Some(mut session) = lock(&self.sessions).get(&event.uuid).cloned() else { return Flow::Continue };
+        if session.window != event.window {
+            return Flow::Continue;
+        }
+        // PICKUP and QUICK_MOVE with either button; a drag, swap or throw does nothing.
+        if !matches!(event.mode, 0 | 1) || !(0..54).contains(&event.slot) {
+            return Flow::Continue;
+        }
+        let Some(stand) = read(host, session.entity) else {
+            host.close_menu(event.uuid);
+            return Flow::Continue;
+        };
+        let creative = creative(&*host, event.uuid);
+        if stand.flags[6] && !creative {
+            host.close_menu(event.uuid);
+            return Flow::Continue;
+        }
+        match click(&stand, &session, event.slot, creative) {
+            Change::None => return Flow::Continue,
+            Change::Close => {
+                host.close_menu(event.uuid);
+                return Flow::Continue;
+            }
+            Change::Tab(t) => session.tab = t,
+            Change::Part(p) => session.part = p,
+            Change::Increment(i) => session.increment = i,
+            Change::Copy => {
+                lock(&self.clipboard).insert(event.uuid, stand.pose);
+            }
+            Change::Paste => {
+                let copied = lock(&self.clipboard).get(&event.uuid).copied();
+                if let Some(pose) = copied {
+                    merge(host, session.entity, pose_nbt(&pose));
+                }
+            }
+            Change::Merge(parts) => {
+                for nbt in parts {
+                    merge(host, session.entity, nbt);
+                }
+            }
+        }
+        let stand = read(host, session.entity).unwrap_or(stand);
+        let shown = stacks(&*host, items(&stand, &session, creative));
+        if let Err(e) = host.menu_set_items(event.uuid, event.window, shown) {
+            eprintln!("[armorstatues] menu_set_items: {e:?}");
+        }
+        lock(&self.sessions).insert(event.uuid, session);
+        Flow::Continue
+    }
+}
