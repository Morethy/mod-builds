+++ b/src/starling_screen.rs
@@ -0,0 +1,155 @@
+//! Starling's port to Sunrise's API: Horizon asked a block entity's Part for its screen (`screen`,
+//! `screen_draw`, `screen_click`, `screen_tooltip`, keyed by the block); Sunrise registers one
+//! screen per menu type, with closures. The Part's old methods run here, through Horizon's events
+//! rebuilt around Sunrise's frame, so the mod's screen code stays as it was written.
+use std::sync::Arc;
+
+use mod_api::{
+    ClientHost, DrawContext, Host, MenuScreen, MenuScreenLayout, MenuScreenOpen, Registrar,
+    ScreenSlot, Text,
+};
+
+/// Horizon's screen layout.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Screen {
+    pub width: f32,
+    pub height: f32,
+    pub slots: Vec<Option<[f32; 2]>>,
+    pub inventory_y: f32,
+    pub inventory_x: f32,
+    pub own_labels: bool,
+    pub own_background: bool,
+    pub recipe_book: Option<mod_api::RecipeBookTypeKey>,
+    pub recipe_book_toggle: Option<[f32; 2]>,
+}
+
+impl Screen {
+    fn layout(self) -> MenuScreenLayout {
+        MenuScreenLayout {
+            width: self.width,
+            height: self.height,
+            slots: self
+                .slots
+                .into_iter()
+                .map(|slot| {
+                    slot.map(|position| ScreenSlot {
+                        position,
+                        no_item_icon: None,
+                    })
+                })
+                .collect(),
+            inventory_y: self.inventory_y,
+            inventory_x: self.inventory_x,
+            own_labels: self.own_labels,
+            own_background: self.own_background,
+            recipe_book: self.recipe_book,
+            recipe_book_toggle: self
+                .recipe_book_toggle
+                .map(|[x, y]| mod_api::RecipeBookToggle {
+                    x,
+                    y,
+                    from: mod_api::ToggleOrigin::Menu,
+                }),
+            ..MenuScreenLayout::default()
+        }
+    }
+}
+
+/// Horizon's `ScreenEvent`: the block whose menu opens.
+pub(crate) struct ScreenEvent<'a> {
+    pub block: &'a str,
+}
+
+/// Horizon's `ScreenDrawEvent`.
+pub(crate) struct ScreenDrawEvent<'a> {
+    pub block: &'a str,
+    pub origin: [f32; 2],
+    pub at: [f32; 2],
+    pub data: &'a [i32],
+    pub draw: &'a mut dyn DrawContext,
+}
+
+/// Horizon's `ScreenClickEvent`.
+pub(crate) struct ScreenClickEvent<'a> {
+    pub block: &'a str,
+    pub origin: [f32; 2],
+    pub at: [f32; 2],
+    pub data: &'a [i32],
+    pub right: bool,
+}
+
+/// Horizon's `ScreenTooltipEvent`.
+pub(crate) struct ScreenTooltipEvent<'a> {
+    pub block: &'a str,
+    pub origin: [f32; 2],
+    pub at: [f32; 2],
+    pub data: &'a [i32],
+    pub slot: Option<u32>,
+    pub lines: &'a mut Vec<(Text, u32)>,
+}
+
+/// A Part's old screen methods.
+pub(crate) trait StarlingScreens: Send + Sync + 'static {
+    fn screen(&self, _host: &dyn Host, _event: &mut ScreenEvent<'_>) -> Option<Screen> {
+        None
+    }
+    fn screen_draw(&self, _host: &dyn ClientHost, _event: &mut ScreenDrawEvent<'_>) {}
+    fn screen_click(&self, _host: &dyn ClientHost, _event: &mut ScreenClickEvent<'_>) -> Option<i32> {
+        None
+    }
+    fn screen_tooltip(&self, _host: &dyn ClientHost, _event: &mut ScreenTooltipEvent<'_>) {}
+}
+
+/// `part`'s screen for the menu type `menu`.
+pub(crate) fn register(r: &mut dyn Registrar, menu: &str, part: impl StarlingScreens) {
+    let part = Arc::new(part);
+    let factory = move |host: &dyn ClientHost, open: MenuScreenOpen<'_>| -> Option<MenuScreen> {
+        let block = open.block.unwrap_or_default().to_owned();
+        let screen = part.screen(host, &mut ScreenEvent { block: &block })?;
+        let (draw_part, click_part, tip_part) = (part.clone(), part.clone(), part.clone());
+        let (draw_block, click_block, tip_block) = (block.clone(), block.clone(), block);
+        Some(
+            MenuScreen::new(screen.layout())
+                .with_draw(move |host, frame, draw| {
+                    draw_part.screen_draw(
+                        host,
+                        &mut ScreenDrawEvent {
+                            block: &draw_block,
+                            origin: frame.origin,
+                            at: frame.at,
+                            data: frame.data,
+                            draw,
+                        },
+                    );
+                })
+                .with_click(move |host, frame, right| {
+                    click_part.screen_click(
+                        host,
+                        &mut ScreenClickEvent {
+                            block: &click_block,
+                            origin: frame.origin,
+                            at: frame.at,
+                            data: frame.data,
+                            right,
+                        },
+                    )
+                })
+                .with_tooltip(move |host, frame, slot, lines| {
+                    tip_part.screen_tooltip(
+                        host,
+                        &mut ScreenTooltipEvent {
+                            block: &tip_block,
+                            origin: frame.origin,
+                            at: frame.at,
+                            data: frame.data,
+                            slot,
+                            lines,
+                        },
+                    );
+                }),
+        )
+    };
+    if let Err(error) = r.register_menu_screen(menu, Arc::new(factory)) {
+        r.refuse(&error);
+    }
+}
diff --git a/botanypots/src/starling_tick.rs b/src/starling_tick.rs
new file mode 100644
index 0000000..4de1a43
--- /dev/null
+++ b/src/starling_tick.rs
@@ -0,0 +1,63 @@
+//! Starling's port to Sunrise's API: a block entity tick written for Horizon's, which handed the
+//! tick the block entity's slots, compound and data slots to change in place, runs here on a copy
+//! of them taken from the tick's view; what it changed is written back and the chunk marked
+//! unsaved, as Horizon's reply did.
+use mod_api::{BlockEntityTickEvent, Compound, ItemStack, ServerHost};
+
+/// The block entity as Horizon's tick had it.
+pub(crate) struct OldEntity {
+    pub items: Vec<Option<ItemStack>>,
+    pub nbt: Compound,
+    pub data: Vec<i32>,
+}
+
+/// Run `body` on a copy of the ticking block entity (its host, the copy, its position).
+pub(crate) fn run(
+    event: &mut BlockEntityTickEvent<'_>,
+    body: impl FnOnce(&mut dyn ServerHost, &mut OldEntity, [i32; 3]),
+) {
+    let Some((handle, pos, before)) = event.subject.with_view(|view| {
+        let items = (0..view.item_slots() as u32)
+            .map(|slot| view.item_slot(slot).and_then(|stack| stack.to_owned()))
+            .collect();
+        let entity = OldEntity {
+            items,
+            nbt: view.nbt().clone(),
+            data: view.data_slots().to_vec(),
+        };
+        (view.handle(), view.position(), entity)
+    }) else {
+        return;
+    };
+    let mut after = OldEntity {
+        items: before.items.clone(),
+        nbt: before.nbt.clone(),
+        data: before.data.clone(),
+    };
+    body(event.subject.host(), &mut after, pos);
+    let mut changed = false;
+    event.subject.with_view(|mut view| {
+        for (key, value) in after.nbt.iter() {
+            if before.nbt.get(key) != Some(value) && view.set_nbt(key.clone(), Some(value.clone())) {
+                changed = true;
+            }
+        }
+        for (key, _) in before.nbt.iter() {
+            if after.nbt.get(key).is_none() && view.set_nbt(key.clone(), None) {
+                changed = true;
+            }
+        }
+        for (slot, stack) in after.items.iter().enumerate() {
+            if before.items.get(slot) != Some(stack) {
+                let _ = view.set_item_slot(slot as u32, stack.clone());
+                changed = true;
+            }
+        }
+        if after.data != before.data && view.set_data_slots(&after.data) {
+            changed = true;
+        }
+    });
+    if changed {
+        let _ = handle.set_changed(event.subject.host());
+    }
+}
