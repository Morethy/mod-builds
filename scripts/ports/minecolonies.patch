+/// Starling's port: every row of `key` with a copy of its value, in holder order. Sunrise's query
+/// is a cursor that lends each value; a row whose value can't be read is skipped, as before.
+fn attachment_rows<T: Clone + Send + Sync + 'static>(
+    host: &dyn Host,
+    key: &AttachmentType<T>,
+) -> Vec<(AttachmentHolder, T)> {
+    let Ok(query) = host.query(key) else {
         return Vec::new();
     };
+    let mut rows = query.iter();
+    let mut out = Vec::new();
+    loop {
+        match rows.try_next() {
+            Ok(Some(row)) => {
+                let Ok(scope) = host.attachment_read_scope() else {
+                    break;
+                };
+                if let Ok(value) = row.with_value(scope, T::clone) {
+                    out.push((row.holder, value));
+                }
+            }
+            Ok(None) => break,
+            // A value error consumes only its row; the others don't advance the cursor.
+            Err(mod_api::AttachmentRowError::Value(_)) => {}
+            Err(_) => break,
+        }
+    }
+    out
+}
