+/// Runs one of the usages above: the executor of each. The readouts are byte-for-byte the retired
+/// port's, so the scenario in `tools/e2e.sh` asserts the same text it always did.
+fn run_command(
+    host: &mut dyn ServerHost,
+    source: &CommandSource,
+    command: &mod_api::CommandInvocation,
+) -> Option<i32> {
+    let action = action_of(&command.literals, &command.arguments);
+    if action == Action::Unknown {
+        return None;
+    }
+    let Some(player) = command_player(source) else {
+        let _ = host.commands().feedback(Text::literal(NEEDS_PLAYER));
+        return Some(1);
+    };
+    let lines: Vec<String> = match action {
+        Action::Help => help_lines().into_iter().map(str::to_owned).collect(),
+        Action::Stats => vec![stats_text(&*host, player)],
+        Action::Assemble { gear, head, rod } => {
+            vec![assemble_command(host, player, &gear, &head, &rod).unwrap_or_else(|line| line)]
         }
-        Flow::Cancel
+        Action::Unknown => return None,
+    };
+    for line in lines {
+        let _ = host.commands().feedback(Text::literal(line));
     }
+    Some(1)
 }
 
