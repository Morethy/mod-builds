+        let queued = {
+            let mut queue = PUSH.lock().unwrap_or_else(|poison| poison.into_inner());
+            std::mem::take(&mut *queue)
+        };
+        if queued.is_empty() {
+            return;
+        }
+        let mut later = Vec::new();
+        for (dim, pos, push) in queued {
+            if dim != dimension {
+                later.push((dim, pos, push));
