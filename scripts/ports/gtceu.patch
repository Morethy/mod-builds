+            }
+            match push {
+                Push::Steam => push_steam(host, level, pos),
+                Push::Energy => push_energy(host, level, pos),
+            }
+        }
+        if !later.is_empty() {
+            PUSH.lock()
+                .unwrap_or_else(|poison| poison.into_inner())
+                .extend(later);
+        }
+    }
