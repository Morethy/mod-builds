+/// Run the seven usages [`Hooks::register_commands`] declares, after the game
+/// has parsed and permission-checked them.
+fn run_command(
+    host: &mut dyn ServerHost,
+    _source: &mod_api::CommandSource,
+    command: &mod_api::CommandInvocation,
+) -> Option<i32> {
+    let literals: Vec<&str> = command.literals.iter().map(String::as_str).collect();
+    match literals.as_slice() {
+        ["laserio", "info"] => laser::info(host, command),
+        ["laserio", "card"] => laser::set_card_command(host, command, true),
+        ["laserio", "remove"] => laser::set_card_command(host, command, false),
+        ["laserio", "mode"] => laser::set_mode_command(host, command),
+        ["laserio", "rate"] => laser::set_rate_command(host, command),
+        ["laserio", "channel"] => laser::set_channel_command(host, command),
+        ["laserio", "face"] => laser::set_face_command(host, command),
+        _ => return None,
     }
+    Some(1)
 }
