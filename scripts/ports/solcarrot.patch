+fn run_command(
+    host: &mut dyn ServerHost,
+    source: &CommandSource,
+    invocation: &mod_api::CommandInvocation,
+) -> Option<i32> {
+    let (command, target) = requested(&invocation.literals, invocation.argument("target"))?;
+    let sender = match source {
+        CommandSource::Player { player, .. } => Some(*player),
+        _ => None,
+    };
+    let permission = match source {
+        CommandSource::Player { permission, .. } => Some(*permission),
+        _ => None,
+    };
+    let Some(target) = target.or(sender) else {
+        let _ = host
+            .commands()
+            .feedback(Text::literal("A player, or a player target, is needed"));
+        return Some(1);
