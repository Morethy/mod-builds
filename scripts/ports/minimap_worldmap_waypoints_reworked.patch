+fn mod_key(host: &dyn ClientHost, id: &str) -> Option<(String, ClientModifiers)> {
+    let mapping = host.mod_key_mapping(runtime::MOD_ID, id).ok()?;
+    mapping
+        .binding(host)
+        .ok()
+        .map(|(key, modifiers)| (key.to_owned(), modifiers))
