+/// What a tick works on: the block entity's item slots, menu data and saved compound, as the old
+/// tick event lent them.
+struct Lent {
+    items: Vec<Option<ItemStack>>,
+    data: Vec<i32>,
+    nbt: Compound,
+}
+
+/// Run one tick on a copy of the resident block entity's fields. `tick` answers what the reply
+/// used to say: `true` (`Changed`) writes the fields that differ back and marks the chunk
+/// unsaved, `false` (`Unchanged`) discards them.
+fn with_lent(
+    event: &mut BlockEntityTickEvent<'_>,
+    tick: impl FnOnce(&mut dyn ServerHost, [i32; 3], &mut Lent) -> bool,
+) {
+    let Some((pos, handle, mut fields)) = event.subject.with_view(|view| {
+        let items = (0..view.item_slots() as u32)
+            .map(|slot| view.item_slot(slot).and_then(|stack| stack.to_owned()))
+            .collect();
+        (
+            view.position(),
+            view.handle(),
+            Lent {
+                items,
+                data: view.data_slots().to_vec(),
+                nbt: view.nbt().clone(),
+            },
+        )
+    }) else {
+        return;
+    };
+    let items = fields.items.clone();
+    let nbt = fields.nbt.clone();
+    if !tick(event.subject.host(), pos, &mut fields) {
+        return;
     }
+    event.subject.with_view(|mut view| {
+        for (slot, stack) in fields.items.iter().enumerate() {
+            if items.get(slot) != Some(stack) {
+                let _ = view.set_item_slot(slot as u32, stack.clone());
+            }
+        }
+        view.set_data_slots(&fields.data);
+        for (key, value) in fields.nbt.iter() {
+            if nbt.get(key) != Some(value) {
+                view.set_nbt(key.clone(), Some(value.clone()));
+            }
+        }
+        for (key, _) in nbt.iter() {
+            if fields.nbt.get(key).is_none() {
+                view.set_nbt(key.clone(), None);
+            }
+        }
+    });
+    let _ = handle.set_changed(event.subject.host());
 }
 
