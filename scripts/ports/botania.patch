+/// Run one tick's body on a copy of the block entity's data, in the level in place, then
+/// write back what it changed and mark the chunk unsaved.
+fn tick_with_data(
+    event: &mut BlockEntityTickEvent<'_>,
+    tick: fn(&mut dyn ServerHost, LevelRef, [i32; 3], &mut Compound),
+) {
+    let Some((pos, handle, before)) = event
+        .subject
+        .with_view(|view| (view.position(), view.handle(), view.nbt().clone()))
+    else {
+        return;
+    };
+    let host = event.subject.host();
+    let Some(level) = level_in_place(host) else {
+        return;
+    };
+    let mut nbt = before.clone();
+    tick(host, level, pos, &mut nbt);
+    let changed = event
+        .subject
+        .with_view(|mut view| {
+            let mut changed = false;
+            for (key, value) in nbt.iter() {
+                if before.get(key) != Some(value) {
+                    changed |= view.set_nbt(key.clone(), Some(value.clone()));
+                }
+            }
+            for (key, _) in before.iter() {
+                if nbt.get(key).is_none() {
+                    changed |= view.set_nbt(key.clone(), None);
+                }
+            }
+            changed
+        })
+        .unwrap_or(false);
+    if changed {
+        handle.set_changed(event.subject.host());
     }
 }
 
