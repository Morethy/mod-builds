+/// Answers the readout from the server's block entity, so it proves the camo is stored and
+/// not only drawn.
+fn run_camo_command(
+    host: &mut dyn ServerHost,
+    command: &mod_api::CommandInvocation,
+) -> Option<i32> {
+    if !is_camo_command(&command.literals) {
+        return None;
+    }
+    let Some(pos) = camo_position(&command.arguments) else {
+        return None;
+    };
+    let Some(dimension) = command.dimension.id(host).map(str::to_owned) else {
+        return None;
+    };
+    let Some(level) = host.level(&dimension) else {
+        return None;
+    };
+    let line = match camo_state_argument(&command.arguments) {
+        Some(state) => set_camo(host, level, pos, &state),
+        None => describe_camo(host, level, pos),
+    };
+    // Routed to the command's source, as vanilla's own feedback is.
+    let _ = host.commands().feedback(Text::literal(line));
+    Some(1)
+}
