+/// The `/bigreactors` command body: read a reactor's state.
+fn run_command(
+    host: &mut dyn ServerHost,
+    _source: &mod_api::CommandSource,
+    command: &mod_api::CommandInvocation,
+) -> Option<i32> {
+    if command.literals.first().map(String::as_str) != Some("bigreactors") {
+        return None;
+    }
+    if command.literals.get(1).map(String::as_str) != Some("status") {
+        return None;
+    }
+    let Some(pos) = position_argument(command.argument("pos")) else {
+        feedback(host, "Usage: /bigreactors status <x> <y> <z>");
+        return Some(1);
+    };
+    let line = status_text(host, pos);
+    feedback(host, &line);
+    Some(1)
+}
+
+/// Writes back the fields a tick changed in its copy of the block entity's compound, as the
+/// tick's own compound was kept before, and marks the chunk changed when any took.
+fn write_back(event: &mut BlockEntityTickEvent<'_>, saved: &Compound, nbt: &Compound) {
+    if nbt == saved {
+        return;
+    }
+    let written = event.subject.with_view(|mut view| {
+        let mut changed = false;
+        for key in saved.keys() {
+            if !nbt.contains_key(key) {
+                changed |= view.set_nbt(key.clone(), None);
+            }
+        }
+        for (key, value) in nbt.iter() {
+            if saved.get(key) != Some(value) {
+                changed |= view.set_nbt(key.clone(), Some(value.clone()));
+            }
+        }
+        (changed, view.handle())
+    });
+    if let Some((true, handle)) = written {
+        let _ = handle.set_changed(event.subject.host());
+    }
+}
