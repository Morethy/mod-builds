+/// The command body: typed arguments in, the same readout text out. The executor of every usage.
+fn run_command(host: &mut dyn ServerHost, command: &mod_api::CommandInvocation) -> Option<i32> {
+    let dimension = command.dimension.id(host)?;
+    let level = host.level(dimension)?;
+    let handled = support::run_command(host, level, &command.literals, &command.arguments);
+    handled.then_some(1)
