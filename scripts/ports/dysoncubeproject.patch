+        }
+        // The tick no longer commits the payload it was lent: write back the fields the tick
+        // changed and mark the chunk unsaved, as the reply did.
+        let changed = event.subject.with_view(|mut view| {
+            let mut changed = false;
+            for (key, value) in nbt.iter() {
