+/// Starling's port: Sunrise offers a capability from a read of the level alone, so the network
+/// behind a merged view is found when the view is used, as the old provider found it.
+enum Net {
+    /// A connector's network, without the asker's own inventory.
+    Connector { pos: [i32; 3], asker: Option<[i32; 3]> },
+    /// A cable connector's: its connector's network.
+    Cable { pos: [i32; 3] },
+}
+
+impl Merged {
+    fn invs(&self, host: &mut dyn ServerHost) -> Vec<Inv> {
+        match self.net {
+            Net::Connector { pos, asker } => {
+                network(host, self.level, pos).into_iter().filter(|i| Some(i.pos) != asker).collect()
+            }
+            Net::Cable { pos } => {
+                let (_, master) = cable_walk(&*host, self.level, pos, true);
+                master.map_or_else(Vec::new, |master| network(host, self.level, master))
+            }
+        }
+    }
 }
 
