+/// Starling's port: the mod's state lives behind an `Arc`, so the menu type's Part (Sunrise asks it
+/// about clicks) reaches the same sessions as the mod's hooks.
+#[derive(Default)]
+struct Mod(Arc<ModInner>);
+
+impl std::ops::Deref for Mod {
+    type Target = ModInner;
+    fn deref(&self) -> &ModInner {
+        &self.0
+    }
+}
+
+/// A click in an open terminal's view.
+struct Clicks(Arc<ModInner>);
+
+#[mod_api::sunrise_part]
+impl mod_api::MenuPart for Clicks {
+    fn menu_clicked(&self, host: &mut dyn ServerHost, event: &mut MenuClickedEvent<'_>) -> Flow {
+        if lock(&self.0.sessions).get(&event.uuid).is_some_and(|s| s.window == event.window) {
+            self.0.click(host, event);
+            Flow::Cancel
+        } else {
+            Flow::Continue
+        }
+    }
+}
