+/// The chest's screen: its eleven slots and the tank readout.
+pub(crate) fn chest_screen(_host: &dyn ClientHost, _open: mod_api::MenuScreenOpen<'_>) -> Option<mod_api::MenuScreen> {
+        let mut slots = Vec::with_capacity(SLOT_COUNT);
+        for row in 0..2 {
+            for column in 0..5 {
+                slots.push(Some(ScreenSlot { position: [8.0 + 18.0 * column as f32, 18.0 + 18.0 * row as f32], no_item_icon: None }));
+            }
+        }
+        slots.push(Some(ScreenSlot { position: [116.0, 27.0], no_item_icon: None }));
+        let layout = MenuScreenLayout {
+            width: 176.0,
+            height: 166.0,
+            slots,
+            inventory_y: 84.0,
+            inventory_x: 8.0,
+            own_labels: false,
+            own_background: false,
+            ..MenuScreenLayout::default()
+        };
+    Some(mod_api::MenuScreen::new(layout).with_draw(|_host, frame, draw| {
+        let tank = frame.data.first().copied().unwrap_or(0).max(0);
+        let text = format!("{tank} / {TANK_CAPACITY} mB");
+        let at = [frame.origin[0] + 8.0, frame.origin[1] + 58.0];
+        draw.text(&text, at, 0xFF40_4040, false);
+    }))
+}
