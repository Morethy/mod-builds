+/// Starling's port: the old `run_mod_command` hook's body.
+pub(crate) fn starling_run_mod_command(
+    host: &mut dyn ServerHost,
+    event: &mut crate::starling_command::RunModCommandEvent<'_>,
+) -> Flow {
+        let literals: Vec<&str> = event.command.literals.iter().map(String::as_str).collect();
+        let line = match literals.as_slice() {
+            ["oritech", "info"] => {
+                let Some(CommandArgumentValue::BlockPos(pos)) = event.command.argument("pos")
+                else {
+                    return Flow::Continue;
+                };
+                support::info_line(host, *pos)
+                    .unwrap_or_else(|| format!("{pos:?} is not a mod block entity."))
+            }
+            ["oritech", "energy"] => {
+                let (
+                    Some(CommandArgumentValue::BlockPos(pos)),
+                    Some(CommandArgumentValue::Integer(amount)),
+                ) = (
+                    event.command.argument("pos"),
+                    event.command.argument("amount"),
+                )
+                else {
+                    return Flow::Continue;
+                };
+                support::set_energy(host, *pos, *amount)
+                    .unwrap_or_else(|| format!("{pos:?} is not an Oritech machine."))
+            }
+            _ => return Flow::Continue,
+        };
+        let _ = host.commands().feedback(Text::literal(line), false);
+        Flow::Cancel
+    }
+
+/// Starling's port: every declared usage runs the old hook's body.
+pub(crate) fn starling_executor(
+    host: &mut dyn ServerHost,
+    source: &mod_api::CommandSource,
+    command: &mod_api::CommandInvocation,
+) -> Option<i32> {
+    crate::starling_command::execute(host, source, command, starling_run_mod_command)
+}
