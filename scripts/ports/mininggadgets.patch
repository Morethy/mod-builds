+/// `change` made on a copy of the stack the editor lends, its custom data and damage staged back:
+/// what the old `&mut ItemStack` edit wrote.
+fn edit_copy(editor: &mut mod_api::ItemComponentEditor<'_>, change: impl FnOnce(&mut ItemStack)) {
+    let Some(mut stack) = editor.original().project() else {
+        return;
+    };
+    change(&mut stack);
+    let mut patch = Compound::new();
+    match data_value(&stack) {
+        Some(tag) => {
+            patch.insert(CUSTOM_DATA.into(), tag);
+        }
+        None => {
+            let removal = format!("!{CUSTOM_DATA}");
+            patch.insert(removal.as_str().into(), Tag::Compound(Compound::new()));
+        }
+    }
+    let _ = editor.apply_components(&patch);
+    editor.set_damage(stack.damage());
+}
