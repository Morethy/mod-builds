+/// Write a tick's edits back to the resident block entity: the saved fields and item slots that
+/// differ from what the tick read, marking the chunk unsaved when any took (the old `Changed`
+/// reply).
+pub(crate) fn write_back(
+    event: &mut BlockEntityTickEvent<'_>,
+    handle: BlockEntityRef,
+    before: &Compound,
+    nbt: &Compound,
+    items_before: &[Option<ItemStack>],
+    items: &[Option<ItemStack>],
+) {
+    let changed = event.subject.with_view(|mut view| {
+        let mut changed = false;
+        for (slot, stack) in items.iter().enumerate() {
+            if items_before.get(slot) != Some(stack) {
+                changed |= view.set_item_slot(slot as u32, stack.clone()).unwrap_or(false);
+            }
+        }
+        for (key, value) in nbt.iter() {
+            if before.get(key) != Some(value) {
+                changed |= view.set_nbt(key.clone(), Some(value.clone()));
+            }
+        }
+        for (key, _) in before.iter() {
+            if nbt.get(key).is_none() {
+                changed |= view.set_nbt(key.clone(), None);
+            }
         }
+        changed
+    });
+    if changed == Some(true) {
+        let _ = handle.set_changed(event.subject.host());
     }
 }
 
