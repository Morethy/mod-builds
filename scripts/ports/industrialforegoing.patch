+/// Every usage's executor: the old `run_mod_command` answer as the command's result.
+fn run_command(
+    host: &mut dyn ServerHost,
+    _source: &mod_api::CommandSource,
+    command: &CommandInvocation,
+) -> Option<i32> {
+    matches!(run_mod_command(host, command), Flow::Cancel).then_some(1)
 }
 
