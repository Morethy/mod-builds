+/// Starling's port: the old `run_mod_command` hook's body.
+pub(crate) fn starling_run_mod_command(
+    host: &mut dyn ServerHost,
+    event: &mut crate::starling_command::RunModCommandEvent<'_>,
+) -> Flow {
+        let literals = &event.command.literals;
+        if literals.first().map(String::as_str) != Some("modern_industrialization") {
+            return Flow::Continue;
+        }
+        match literals.get(1).map(String::as_str) {
+            Some("info") => {
+                report(host, event.command);
+                Flow::Cancel
+            }
+            Some("energy") => {
+                set(host, event.command, Alter::Energy);
+                Flow::Cancel
+            }
+            Some("efficiency") => {
+                set(host, event.command, Alter::Efficiency);
+                Flow::Cancel
+            }
+            Some("recipes") => {
+                list_recipes(host);
+                Flow::Cancel
+            }
+            Some("shape") => {
+                match_shape(host, event.command);
+                Flow::Cancel
+            }
+            _ => Flow::Continue,
+        }
+    }
+
+/// Starling's port: every declared usage runs the old hook's body.
+pub(crate) fn starling_executor(
+    host: &mut dyn ServerHost,
+    source: &mod_api::CommandSource,
+    command: &mod_api::CommandInvocation,
+) -> Option<i32> {
+    crate::starling_command::execute(host, source, command, starling_run_mod_command)
+}
diff --git a/modern_industrialization/src/starling_command.rs b/src/starling_command.rs
new file mode 100644
index 0000000..894f55f
--- /dev/null
+++ b/src/starling_command.rs
@@ -0,0 +1,31 @@
+//! Starling's port to Sunrise's API: Horizon's `run_mod_command` hook, which got every command of
+//! the mod in one event, is a per-usage executor in Sunrise. The old event is rebuilt here around
+//! the executor's arguments, so the mod's command code runs as it was written.
+use mod_api::{CommandInvocation, CommandSource, Flow, ServerHost};
+
+/// Horizon's `RunModCommandEvent`: the parsed command and who ran it.
+pub(crate) struct RunModCommandEvent<'a> {
+    pub command: &'a CommandInvocation,
+    pub source: &'a CommandSource,
+    /// Whether an earlier mod took the command: in Sunrise each usage has its own executor, so never.
+    pub cancelled: bool,
+}
+
+/// The executor of every usage the mod declares: the old hook's body (`run`), whose `Cancel` was a
+/// command it ran and `Continue` one it did not.
+pub(crate) fn execute(
+    host: &mut dyn ServerHost,
+    source: &CommandSource,
+    command: &CommandInvocation,
+    run: fn(&mut dyn ServerHost, &mut RunModCommandEvent<'_>) -> Flow,
+) -> Option<i32> {
+    let mut event = RunModCommandEvent {
+        command,
+        source,
+        cancelled: false,
+    };
+    match run(host, &mut event) {
+        Flow::Continue => None,
+        _ => Some(1),
+    }
+}
diff --git a/modern_industrialization/src/starling_tick.rs b/src/starling_tick.rs
new file mode 100644
index 0000000..16e2c71
--- /dev/null
+++ b/src/starling_tick.rs
@@ -0,0 +1,63 @@
+//! Starling's port to Sunrise's API: code written for Horizon's, which handed a block entity's
+//! slots, compound and data slots (`ModBlockEntityFields`) to a tick or a menu button to change in
+//! place, runs here on a copy of them taken from Sunrise's view; what it changed is written back and
+//! the chunk marked unsaved, as Horizon's reply did.
+use mod_api::{BlockEntityScope, BlockEntityTickEvent, ServerHost};
+
+/// The block entity as Horizon's tick had it.
+pub(crate) type OldEntity = mod_api::item::containers::ModBlockEntityFields;
+
+/// Run `body` on a copy of the ticking block entity (its host, the copy, its position).
+pub(crate) fn run(
+    event: &mut BlockEntityTickEvent<'_>,
+    body: impl FnOnce(&mut dyn ServerHost, &mut OldEntity, [i32; 3]),
+) {
+    run_scope(&mut event.subject, body);
+}
+
+/// Run `body` on a copy of the block entity `subject` lends (a tick's, a menu button's).
+pub(crate) fn run_scope(
+    subject: &mut BlockEntityScope<'_>,
+    body: impl FnOnce(&mut dyn ServerHost, &mut OldEntity, [i32; 3]),
+) {
+    let Some((handle, pos, before)) = subject.with_view(|view| {
+        let items = (0..view.item_slots() as u32)
+            .map(|slot| view.item_slot(slot).and_then(|stack| stack.to_owned()))
+            .collect();
+        let entity = OldEntity {
+            items,
+            nbt: view.nbt().clone(),
+            data: view.data_slots().to_vec(),
+        };
+        (view.handle(), view.position(), entity)
+    }) else {
+        return;
+    };
+    let mut after = before.clone();
+    body(subject.host(), &mut after, pos);
+    let mut changed = false;
+    subject.with_view(|mut view| {
+        for (key, value) in after.nbt.iter() {
+            if before.nbt.get(key) != Some(value) && view.set_nbt(key.clone(), Some(value.clone())) {
+                changed = true;
+            }
+        }
+        for (key, _) in before.nbt.iter() {
+            if after.nbt.get(key).is_none() && view.set_nbt(key.clone(), None) {
+                changed = true;
+            }
+        }
+        for (slot, stack) in after.items.iter().enumerate() {
+            if before.items.get(slot) != Some(stack) {
+                let _ = view.set_item_slot(slot as u32, stack.clone());
+                changed = true;
+            }
+        }
+        if after.data != before.data && view.set_data_slots(&after.data) {
+            changed = true;
+        }
+    });
+    if changed {
+        let _ = handle.set_changed(subject.host());
+    }
+}
