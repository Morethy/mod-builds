+                feedback(host, &line);
+            }
+            Some("energy") => {
+                let Some(amount) = integer_argument(event.command.argument("amount")) else {
+                    feedback(host, "usage: /techreborn energy <x> <y> <z> <amount>");
+                    return Flow::Cancel;
+                };
