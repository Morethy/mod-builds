+/// The custom data of a stack, whether it is an owned copy or the component editor an item
+/// place lends for an edit in place.
+trait CustomDataStore {
+    fn custom_data(&self) -> Option<Compound>;
+    fn clear_custom_data(&mut self);
+    fn set_custom_data(&mut self, data: Compound);
+}
+
+impl CustomDataStore for ItemStack {
+    fn custom_data(&self) -> Option<Compound> {
+        self.get(&CustomData)
+    }
+
+    fn clear_custom_data(&mut self) {
+        self.remove(&CustomData);
+    }
+
+    fn set_custom_data(&mut self, data: Compound) {
+        let _ = self.set(&CustomData, data);
+    }
+}
+
+impl CustomDataStore for mod_api::ItemComponentEditor<'_> {
+    fn custom_data(&self) -> Option<Compound> {
+        self.get(&CustomData)
+    }
+
+    fn clear_custom_data(&mut self) {
+        self.remove(&CustomData);
+    }
+
+    fn set_custom_data(&mut self, data: Compound) {
+        let _ = self.set(&CustomData, data);
+    }
+}
