+/// What the health HUD told while it drew: nothing with the HUD hidden or outside
+/// survival and adventure, as the hearts themselves.
+fn health_hud(host: &dyn ClientHost) {
+    if host.hud_mode() != mod_api::HudMode::AllVisible {
+        return;
+    }
+    let Some(player) = host.local_player() else {
+        return;
+    };
+    if !matches!(
+        player.game_mode(host),
+        Some(mod_api::GameMode::Survival | mod_api::GameMode::Adventure)
+    ) {
+        return;
     }
+    let entity = player.entity();
+    let Some(health) = host.living(entity).and_then(|living| living.health(host)) else {
+        return;
+    };
+    let riding = entity
+        .vehicle(host)
+        .is_some_and(|vehicle| host.living(vehicle).is_some());
+    camera::health(health, riding);
+    UNDER_WATER.set(entity.is_under_water(host).unwrap_or(false));
 }
